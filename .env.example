# ---- Supabase（Project Settings → API）----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# 只放在服务器端，绝对不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- 管理员账号（登录ID:邮箱，逗号分隔，两三个人）----
# 登录时只输入 ID 和密码；邮箱用于 Supabase 账号和到期提醒邮件
# 每个人还要在 Supabase → Authentication → Users 里用同一个邮箱创建用户并设定密码
ADMIN_ACCOUNTS=alice:alice@example.com,bob:bob@example.com

# ---- 用于签名“已输入密码”Cookie 的随机串（至少 32 字符）----
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
UNLOCK_SECRET=

# ---- 定时任务密钥（Vercel Cron 会自动带上 Authorization: Bearer <CRON_SECRET>）----
CRON_SECRET=

# ---- 邮件（Resend：https://resend.com）----
RESEND_API_KEY=re_...
# 没有验证自有域名时只能用 onboarding@resend.dev，且只能发给 Resend 注册邮箱
MAIL_FROM=Doc Share <onboarding@resend.dev>

# ---- 站点地址（邮件里的链接用）----
SITE_URL=https://private-doc-share-box.vercel.app

# ---- 可选 ----
# 文件保留天数（默认 30）
RETENTION_DAYS=30
# 到期前几天发提醒（默认 3）
REMIND_DAYS_BEFORE=3
# 单文件上限 MB（默认 20，需 ≤ Supabase 桶的限制）
MAX_FILE_MB=20
# 设为 false 关闭“在线预览”（预览会把一个临时链接交给微软 Office Online 读取）
ENABLE_OFFICE_PREVIEW=true
