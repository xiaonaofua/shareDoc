# Vercel → Settings → Environment Variables 只需要填这 3 个
# 值在 Supabase → Project Settings → API（或右上角 Connect）里复制
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# 只放在服务器端，绝对不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- 以下全部可选，不填就用默认值 ----
# RETENTION_DAYS=30            文件保留天数
# MAX_FILE_MB=20               单文件上限（MB）
# ENABLE_OFFICE_PREVIEW=true   设为 false 关闭微软 Office 在线预览
